{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "Swedish"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 WorkReview",
    "category": "Productivity",
    "shortDescription": "Lokalt arbetsunderlag och tidrapporter för Spiris Tid",
    "longDescription": "GRIT Work samlar arbetsunderlag, arkiverar säkert och skapar granskbara tidrapporter.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "xdotool",
          "xprintidle",
          "x11-utils",
          "libglib2.0-bin",
          "tesseract-ocr",
          "gnome-screenshot | grim | scrot | maim | imagemagick",
          "procps"
        ]
      },
      "rpm": {
        "depends": [
          "xdotool",
          "xprintidle",
          "xorg-x11-utils",
          "glib2",
          "tesseract",
          "gnome-screenshot",
          "procps-ng"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "productName": "GRIT Work",
  "mainBinaryName": "grit-work",
  "version": "1.1.4-rc.3",
  "identifier": "se.grit.work",
  "plugins": {},
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "GRIT Work",
        "width": 1000,
        "height": 700,
        "visible": false,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": false,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://api.github.com https://gh-proxy.cn https://gh-proxy.com"
    }
  }
}
